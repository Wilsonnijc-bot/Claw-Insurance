{
  "providers": {
    "litellm": {
      "baseUrl": "https://api.moonshot.cn/v1",
      "apiKey": "your-openai-compatible-api-key"
    }
  },
  "agents": {
    "defaults": {
      "model": "kimi-k3",
      "provider": "litellm",
      "temperature": 1.0
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "deliveryMode": "draft",
      "bridgeUrl": "ws://localhost:3001"
    }
  },
  "interviewProxy": {
    "baseUrl": "http://mock-cloud:5050",
    "apiKey": "demo-interview-key"
  },
  "privacyGateway": {
    "enabled": true,
    "failClosed": true,
    "saveRedactedDebug": false,
    "textOnlyScope": true
  },
  "gateway": {
    "heartbeat": {
      "enabled": false
    }
  },
  "tools": {
    "restrictToWorkspace": true
  }
}
