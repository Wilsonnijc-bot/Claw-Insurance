# The backend and frontend must use the same application version.
CLAW_VERSION=1.1.0
BACKEND_IMAGE=hendrickyan/claw-insurance-backend
FRONTEND_IMAGE=hendrickyan/claw-insurance-frontend

# The setup script updates the helper token and platform automatically.
WEB_BROWSER_MODE=cdp
WEB_CDP_URL=http://host.docker.internal:9222
WEB_CDP_HELPER_URL=http://host.docker.internal:9230
WEB_CDP_HELPER_TOKEN=
WEB_CDP_HELPER_PLATFORM=
WEB_HOST_PROFILE_DIR=./whatsapp-web
WEB_HISTORY_SYNC_ENABLED=true
BRIDGE_STARTUP_TIMEOUT_SECONDS=60

